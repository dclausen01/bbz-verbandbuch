# ============================================================================
#  Verbandsbuch BBZ – Beispiel-Umgebung. Kopieren nach `.env` und anpassen.
#  In Produktion (Plesk) die Werte direkt als Umgebungsvariablen setzen.
# ============================================================================

# --- Session (nuxt-auth-utils) --------------------------------------------
# Mind. 32 Zeichen langer, geheimer Schlüssel zum Signieren des Session-Cookies.
NUXT_SESSION_PASSWORD=bitte-einen-mindestens-32-zeichen-langen-schluessel-setzen

# --- Server / Datenbank ----------------------------------------------------
# Port (Plesk/Passenger setzt diesen i.d.R. selbst).
PORT=3000
# Pfad zur SQLite-Datei. Sollte auf einem persistenten Verzeichnis liegen.
DB_PATH=./data/verbandbuch.db
# Login-Kennungen (kommagetrennt), die beim ersten Login automatisch ADMIN werden.
# Standardmäßig ist bereits "ClauD" gesetzt (siehe nuxt.config.ts). Nur
# überschreiben, wenn andere/zusätzliche Admins gewünscht sind:
# NUXT_INITIAL_ADMINS=ClauD,weitere.kennung
# Unbekannte LDAP-Nutzer automatisch als REPORTER anlegen? (true|false)
NUXT_AUTO_PROVISION=true

# --- Entwicklungsmodus -----------------------------------------------------
# true = Login ohne LDAP über devUser.json (Passwort wird ignoriert).
NUXT_PUBLIC_IS_DEV=false
NUXT_PUBLIC_DEV_USER_INDEX=0

# --- LDAP / Active Directory ----------------------------------------------
# (nur im Produktivbetrieb nötig, wenn NUXT_PUBLIC_IS_DEV=false)
LDAP_URL=ldaps://dc01.schule.local:636
LDAP_BASE_DN=OU=Lehrkraefte,DC=schule,DC=local
# Suchfilter mit Platzhalter {{username}} (AD-Standard: sAMAccountName)
LDAP_USER_FILTER=(sAMAccountName={{username}})
LDAP_LOGIN_ATTR=sAMAccountName
LDAP_NAME_ATTR=displayName

# Variante A – Service-Account (Standard): Lese-Nutzer für die Suche.
LDAP_BIND_DN=CN=Verbandsbuch-Service,OU=Dienste,DC=schule,DC=local
LDAP_BIND_PW=service-account-passwort

# Variante B – Direkt-Bind (kein Service-Account nötig). Wenn gesetzt, wird
# Variante A ignoriert. Platzhalter {{username}}, z.B. NetBIOS oder UPN:
# LDAP_BIND_USER_TEMPLATE=SCHULE\{{username}}
# LDAP_BIND_USER_TEMPLATE={{username}}@schule.local

# TLS für ldaps:// – interne CA (empfohlen) ODER Prüfung abschalten (Notlösung).
# LDAP_TLS_CA_PFAD=/etc/ssl/certs/schule-ca.pem
# LDAP_TLS_REJECT_UNAUTHORIZED=false
